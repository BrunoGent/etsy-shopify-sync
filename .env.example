# Etsy API v3 Credentials
ETSY_KEYSTRING=your_etsy_keystring_here
ETSY_SHARED_SECRET=your_etsy_shared_secret_here
ETSY_SHOP_ID=your_etsy_shop_id_here
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_TOKEN_EXPIRES_AT=

# Shopify Admin API Credentials (Custom App Client Credentials)
SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here

# Optional: Shopify API version to use (leave blank for the built-in default)
SHOPIFY_API_VERSION=

# Optional: folder that uploads to the cloud; orders.db is copied here after every run
# Leave empty to back up into a local "backups" folder. Cloud example: BACKUP_DIR=G:\My Drive\EtsySyncBackups
BACKUP_DIR=
